# Режим работы:
# demo      - без API-ключей, учебные ответы-заглушки
# openai    - реальные запросы в OpenAI API
# anthropic - реальные запросы в Anthropic API
AI_PROVIDER=demo

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Сколько субагентов запускать:
# auto - диспетчер выбирает по смыслу
# all  - всегда запускаются все базовые субагенты
ROUTING_MODE=auto

# ---------------------------------------------
# Контентный мультиагент:
# 1. исследователь ищет информацию;
# 2. копирайтер пишет пост;
# 3. дизайнер генерирует картинку;
# 4. Telegram-агент публикует.
# ---------------------------------------------

# demo   - без API, безопасный учебный режим
# claude - AI-части выполняет Claude Code в VS Code по CLAUDE.md, скрипт не вызывает API
# openai - реальный режим через OpenAI API
CONTENT_PROVIDER=demo

# Модель для исследования и текста.
# Для web_search в OpenAI Responses API используйте модель, которая поддерживает web_search.
OPENAI_TEXT_MODEL=gpt-4.1-mini

# true - использовать OpenAI web_search;
# false - исследователь будет работать без live-поиска
USE_WEB_SEARCH=true

# true - реально генерировать картинку через OpenAI image_generation;
# false - создать учебную SVG-заглушку
GENERATE_REAL_IMAGE=false
OPENAI_IMAGE_MODEL=gpt-5.5

# true - реально публиковать в Telegram;
# false - только показать, что было бы опубликовано
POST_TO_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Время автопостинга для npm run content:scheduler.
# Формат: HH:MM через запятую, по локальному времени компьютера/сервера.
AUTOPOST_TIMES=09:00,14:00,19:00
